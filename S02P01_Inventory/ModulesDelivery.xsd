<?xml version="1.0" encoding="UTF-8"?>
<xs:schema  version="1.2"
            xmlns:xs="http://www.w3.org/2001/XMLSchema" 
            xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
            elementFormDefault="qualified" 
            vc:minVersion="1.1" 
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <xs:annotation>
      <xs:appinfo>ITxPT S02P01 Module Inventory service - Modules Delivery XML Schema Definition Version 2.2.0</xs:appinfo>
      <xs:documentation>ITxPT service interface for standardized interoperability in public transport - XML schema</xs:documentation>
  </xs:annotation>
  <!-- Type definitions -->
  <xs:simpleType name="VersionType">
      <xs:restriction base="xs:string">
        <xs:enumeration value="2.2.0"/>
      </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReleaseType">
      <xs:restriction base="xs:string">
        <xs:enumeration value="Linden"/>
      </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="MACAddressType">
    <xs:restriction base="xs:string">
    <xs:pattern value="[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}"/>
  </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="EcoModeType">
      <xs:restriction base="xs:string">
        <xs:enumeration value="ECO0"/>
        <xs:enumeration value="ECO1"/>
        <xs:enumeration value="ECO2"/>
        <xs:enumeration value="SLEEP"/>
      </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="StatusListType">
    <xs:sequence>
      <xs:element minOccurs="1" maxOccurs="30" name="Item" type="ItemType"/>
    </xs:sequence>
    <xs:attribute name="page" type="pageType" use="required" />
  </xs:complexType>
  <xs:complexType name="XStatusType">
    <xs:simpleContent>      
      <xs:extension base="XStatusFormatType">
        <xs:attribute name="page" type="pageType" use="required" />
        <xs:attribute name="timestamp" type="xs:dateTime" use="required" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="XStatusFormatType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{16}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="pageType">
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="16"/>
    </xs:restriction>  
  </xs:simpleType>
  <xs:complexType name="SubModulesType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="Type" type="xs:string"/>
      <xs:element name="Model" type="xs:string"/>
      <xs:element name="Manufacturer" type="xs:string"/>
      <xs:element name="SerialNumber" type="xs:string"/>
      <xs:element name="SoftwareVersion" type="xs:string"/>
      <xs:element name="HardwareVersion" type="xs:string"/>
      <xs:element name="Status" type="xs:nonNegativeInteger"/>
      <xs:element minOccurs="0" maxOccurs="16" name="XStatus" type="XStatusType"/>
      <xs:element minOccurs="0" name="Extensions" type="xs:anyType"/>
    </xs:choice>
    <!-- Assert conditions to enforce multiplicity and uniqueness constraints -->
    <xs:assert test="count(Type) = 1"/>
    <xs:assert test="count(Model) = 1"/>
    <xs:assert test="count(Manufacturer) = 1"/>
    <xs:assert test="count(SerialNumber) = 1"/>
    <xs:assert test="count(SoftwareVersion) = 1"/>
    <xs:assert test="count(HardwareVersion) = 1"/>
    <xs:assert test="count(Status) = 1"/>
    <xs:assert test="count(XStatus) &lt;= 16"/>
    <xs:assert test="count(Extensions) &lt;= 1"/>
  </xs:complexType>
  <xs:simpleType name="ServiceNameType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="inventory"/>
      <xs:enumeration value="time"/>
      <xs:enumeration value="gnsslocation"/>
      <xs:enumeration value="fmstoip"/>
      <xs:enumeration value="vehicletoip"/>
      <xs:enumeration value="avms"/>
      <xs:enumeration value="apc"/>
      <xs:enumeration value="madt"/>
      <xs:enumeration value="mqtt-broker"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ServiceTypeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="itxpt_socket"/>
      <xs:enumeration value="itxpt_http"/>
      <xs:enumeration value="sntp"/>
      <xs:enumeration value="itxpt_multicast"/>
      <xs:enumeration value="mqtt"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="ServicesType">
    <xs:all>
      <xs:element name="ServiceName" type="ServiceNameType"/>
      <xs:element name="ServiceType" type="ServiceTypeType"/>
    </xs:all>
  </xs:complexType>
  <xs:complexType name="ItemType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="code" type="itemCodeType"/>          
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="itemCodeType">
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="30"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ModuleTypeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="VCG"/>
      <xs:enumeration value="ESW"/>
      <xs:enumeration value="MESW"/>
      <xs:enumeration value="FMSIPGW"/>
      <xs:enumeration value="MADT"/>
      <xs:enumeration value="GNSS"/>
      <xs:enumeration value="AVMS"/>
      <xs:enumeration value="DPI"/>
      <xs:enumeration value="REMA"/>
      <xs:enumeration value="APC"/>
      <xs:enumeration value="TICK"/>
      <xs:enumeration value="PRVR"/>
      <xs:enumeration value="RFIDR"/>
      <xs:enumeration value="EXTD"/>
      <xs:enumeration value="INTD"/>
      <xs:enumeration value="OBU"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="ModuleType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="Type" type="ModuleTypeType"/>
      <xs:element name="Model" type="xs:string"/>
      <xs:element name="Manufacturer" type="xs:string"/>
      <xs:element name="SerialNumber" type="xs:string"/>
      <xs:element name="SoftwareVersion" type="xs:string"/>
      <xs:element name="HardwareVersion" type="xs:string"/>
      <xs:element name="MACAddress" type="MACAddressType"/>
      <xs:element minOccurs="0" name="EcoMode" type="EcoModeType"/>
      <xs:element name="Status" type="xs:nonNegativeInteger"/>
      <xs:element minOccurs="0" maxOccurs="16" name="XStatus" type="XStatusType"/>
      <xs:element minOccurs="0" maxOccurs="16" name="StatusList" type="StatusListType"/>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="SubModules" type="SubModulesType"/>
      <xs:element minOccurs="1" maxOccurs="unbounded" name="Services" type="ServicesType"/>
      <xs:element minOccurs="0" name="Extensions" type="xs:anyType"/>
    </xs:choice>
    <!-- Assert conditions to enforce multiplicity and uniqueness constraints -->
    <xs:assert test="count(Type) = 1"/>
    <xs:assert test="count(Model) = 1"/>
    <xs:assert test="count(Manufacturer) = 1"/>
    <xs:assert test="count(SerialNumber) = 1"/>
    <xs:assert test="count(SoftwareVersion) = 1"/>
    <xs:assert test="count(HardwareVersion) = 1"/>
    <xs:assert test="count(MACAddress) = 1"/>
    <xs:assert test="count(EcoMode) &lt;= 1"/>
    <xs:assert test="count(Status) = 1"/>
    <xs:assert test="count(XStatus) &lt;= 16"/>
    <xs:assert test="count(StatusList) &lt;= 16"/>
    <xs:assert test="count(SubModules) &lt;= 16"/>
    <xs:assert test="count(Services) &gt; 0"/>
    <xs:assert test="count(Extensions) &lt;= 1"/>
  </xs:complexType>

  <!-- Main element definition -->
  <xs:element name="ModulesDelivery">
    <xs:complexType>
      <xs:all>
        <xs:element name="Module" type="ModuleType"/>
        <xs:element minOccurs="0" name="Extensions" type="xs:anyType"/>
      </xs:all>
      <xs:attribute name="version" use="required" type="VersionType"/>
      <xs:attribute name="release" use="required" type="ReleaseType"/>
      <xs:attribute name="atdatetime" use="required" type="xs:dateTime"/>
      <xs:attribute name="interval" use="required" type="xs:positiveInteger"/>
    </xs:complexType>
  </xs:element>
</xs:schema>