<?xml version="1.0" encoding="UTF-8"?>
<xs:schema  version="1.1" 
            xmlns:xs="http://www.w3.org/2001/XMLSchema" 
            xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
            elementFormDefault="qualified" 
            vc:minVersion="1.1" 
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <xs:annotation>
    <xs:appinfo>ITxPT S02P07 APC service - Passenger Vehicle Count operation XML Schema Definition Version 2.2.0</xs:appinfo>
    <xs:documentation>ITxPT service interface for standardized interoperability in public transport - XML schema</xs:documentation>
  </xs:annotation>
  <!-- Type definitions -->
  <xs:simpleType name="VersionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="2.2.0"/>
      <xs:enumeration value="2.2.1"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ObjectClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Adult"/>
      <xs:enumeration value="Child"/>
      <xs:enumeration value="Pram"/>
      <xs:enumeration value="Bike"/>
      <xs:enumeration value="Wheelchair"/>
      <xs:enumeration value="Other"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="VehicleCountQualityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Regular"/>
      <xs:enumeration value="Defect"/>
      <xs:enumeration value="Other"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="VehicleCountingType">
    <xs:all>
      <xs:element minOccurs="0" name="ObjectClass" type="ObjectClassType"/>
      <xs:element name="VehiclePassengerIn" type="xs:nonNegativeInteger"/>
      <xs:element name="VehiclePassengerOut" type="xs:nonNegativeInteger"/>
    </xs:all>
  </xs:complexType>
  <xs:simpleType name="VehicleOccupancyRatioType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.0"/>
      <xs:maxInclusive value="10.0"/> <!-- 1.0 is 100%, more that 100% is possible so we put max on 10.0 that is 1000% -->
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="PassengerVehicleCountType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="RecordedAtTime" type="xs:dateTime"/>
      <xs:element minOccurs="0" name="StopPointRef" type="xs:string"/>
      <xs:element maxOccurs="unbounded" name="VehicleCounting" type="VehicleCountingType"/>
      <xs:element minOccurs="0" name="VehicleCountQuality" type="VehicleCountQualityType"/>
      <xs:element name="VehicleOccupancy" type="xs:nonNegativeInteger"/>
      <xs:element minOccurs="0" name="VehicleOccupancyRatio" type="VehicleOccupancyRatioType"/>
      <xs:element minOccurs="0" name="Extensions" type="xs:anyType"/>
    </xs:choice>
    <!-- Assert conditions to enforce multiplicity and uniqueness constraints -->
    <xs:assert test="count(RecordedAtTime) = 1"/>
    <xs:assert test="count(StopPointRef) &lt;= 1"/>
    <xs:assert test="count(VehicleCounting) &gt;= 1"/>
    <xs:assert test="count(VehicleCountQuality) &lt;= 1"/>
    <xs:assert test="count(VehicleOccupancy) = 1"/>
    <xs:assert test="count(VehicleOccupancyRatio) &lt;= 1"/>
    <xs:assert test="count(Extensions) &lt;= 1"/>
  </xs:complexType>

  <!-- Main element definition -->
  <xs:element name="PassengerVehicleCountDelivery">
    <xs:complexType>
      <xs:all>
        <xs:element name="PassengerVehicleCount" type="PassengerVehicleCountType"/>
        <xs:element minOccurs="0" name="Extensions" type="xs:anyType"/>
      </xs:all>
      <xs:attribute name="version" use="required" type="VersionType"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
